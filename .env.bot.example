# ralevel applications Discord bot (apps/bot)
#
# Local dev: copy to apps/bot/.env and run `pnpm dev:bot`. You only need the bot
# when working on Discord notifications or ban appeals.
# Guide: dev-onboarding/08-optional-services/discord-bot.md
# Production: these are set in the Coolify bot app (see docs/COOLIFY-BOT.md).
#
# Never commit apps/bot/.env and never paste its values anywhere.

# Port the website's BOT_INTERNAL_URL points at.
PORT=8787

# Your local dev database. Never point this at production.
MONGODB_URI=mongodb://127.0.0.1:27027/ralevel_dev

# Must match INTERNAL_BOT_SECRET in apps/website/.env.local.
INTERNAL_BOT_SECRET=local-dev-secret

# Your own Discord test server + bot application. Without DISCORD_PUBLIC_KEY the
# bot starts but Discord interactions return 503.
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_APPLICATIONS_CHANNEL_ID=
DISCORD_BAN_APPEAL_CHANNEL_ID=
DISCORD_JR_ADMIN_ROLE_ID=
DISCORD_SR_ADMIN_ROLE_ID=
# Comma-separated roles that can review ban appeals. If empty, the jr + sr admin
# roles above are used.
DISCORD_APPEAL_REVIEWER_ROLE_IDS=

# Ban appeal outcome emails. Your own Resend account; without a key, emails are
# skipped. A new account can only send from onboarding@resend.dev.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Used when building admin URLs in Discord embeds (SITE_URL is also accepted).
NEXT_PUBLIC_URL=http://localhost:3000

# Bearer token for GET /cron/form-reminders (Coolify cron: 30 0 * * * UTC).
CRON_SECRET=
