# ralevel applications Discord bot (apps/bot)
# Copy to apps/bot/.env.local or set in Coolify bot app env.

PORT=8787
MONGODB_URI=

# Same secret as website BOT_INTERNAL_URL auth
INTERNAL_BOT_SECRET=long-random-shared-secret

# Discord bot token + channels/roles
DISCORD_NOTIFICATIONS_ENABLED=true
DISCORD_BOT_TOKEN=
DISCORD_APPLICATIONS_CHANNEL_ID=
DISCORD_JR_ADMIN_ROLE_ID=
DISCORD_SR_ADMIN_ROLE_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_BAN_APPEAL_CHANNEL_ID=
DISCORD_APPEAL_REVIEWER_ROLE_IDS=

# Used when building admin URLs in Discord embeds
NEXT_PUBLIC_URL=https://ralevel.com
# Alias also accepted:
# SITE_URL=https://ralevel.com

# Coolify cron: GET /cron/form-reminders with this bearer token (30 0 * * * UTC)
CRON_SECRET=
