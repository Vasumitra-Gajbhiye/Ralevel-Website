# apps/website environment
#
# Local dev: copy this file to apps/website/.env.local and fill in the blanks.
# Guides live in dev-onboarding/ (start with dev-onboarding/README.md).
#
#   Tier 1  needed to run the site at all. Set these on day one.
#   Tier 2  set up when a task needs that feature, using your OWN free/test account.
#   Tier 3  rarely needed; ask the owner before setting these up.
#
# Never commit .env.local and never paste its values anywhere. The repo is public.
# Production values live only in Coolify / GitHub; you'll never need them.

# ─── Tier 1: database ────────────────────────────────────────────────────────
# Your local dev database (`pnpm db:up`). Never point this at production.
# Guide: dev-onboarding/03-local-databases.md
MONGODB_URI=mongodb://127.0.0.1:27027/ralevel_dev

# ─── Tier 1: site URL ────────────────────────────────────────────────────────
# Base URL for links in emails, Discord embeds, share links and Stripe redirects.
NEXT_PUBLIC_URL=http://localhost:3000

# ─── Tier 1: Clerk (sign-in) ─────────────────────────────────────────────────
# Your own Clerk app's Development keys (pk_test_ / sk_test_ only). Without them
# every page fails to load. Guide: dev-onboarding/05-clerk-setup.md
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keep these as they are.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Not needed locally (production-only webhook): CLERK_WEBHOOK_SIGNING_SECRET

# ─── Tier 1: images ──────────────────────────────────────────────────────────
# Cloudinary cloud the site's images are served from. This is production's
# PUBLIC cloud name (it appears in every image URL on ralevel.com), so seeded
# content shows its images. Not a secret. Pages with images crash without it.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=doqsecks2

# ─── Tier 1: Redis (off by default) ──────────────────────────────────────────
# Caching + rate limiting. Off locally; the site works without it.
# To test it: `pnpm db:up` already starts Redis, then set REDIS_ENABLED=true.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6389

# ─── Tier 2: Cloudinary uploads ──────────────────────────────────────────────
# Your own free Cloudinary account. Needed only to upload images in the admin
# pages (blog heroes, avatars, logos, thumbnails, certificates); uploads fail
# without it. Guide: dev-onboarding/08-optional-services/cloudinary.md
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Tier 2: Stripe (test mode only) ─────────────────────────────────────────
# Your own Stripe account in TEST mode (sk_test_ / pk_test_). Needed for the
# Minecraft funding checkout; checkout fails without it. Webhook secret comes
# from `stripe listen`. Guide: dev-onboarding/08-optional-services/stripe.md
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Tier 2: Resend (email) ──────────────────────────────────────────────────
# Your own free Resend account. Without a key, emails are skipped and logged to
# the terminal instead. A new account can only send from onboarding@resend.dev
# to your own address. Guide: dev-onboarding/08-optional-services/resend.md
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Tier 2: PostHog (analytics) ─────────────────────────────────────────────
# Optional. Leave blank and analytics are off. If you want it, create your own
# free project in the EU region. Guide: dev-onboarding/08-optional-services/posthog.md
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Tier 2: Gemini (theory answer marking) ──────────────────────────────────
# Your own free Google AI Studio key. Without it /api/theory-eval returns 503.
# Guide: dev-onboarding/08-optional-services/gemini.md
GEMINI_API_KEY=

# ─── Tier 2: Discord (ban appeals + applications bot) ────────────────────────
# Your own Discord test server + bot application. Needed for the ban-appeal
# Discord login and for sending notifications through apps/bot.
# Guide: dev-onboarding/08-optional-services/discord-bot.md
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
# Only for `pnpm --filter @ralevel/website register-discord-appeal-commands`.
DISCORD_BOT_TOKEN=
# Where the local bot (`pnpm dev:bot`) listens. Leave BOT_INTERNAL_URL commented
# out unless the bot is running; without it the site skips bot notifications.
# INTERNAL_BOT_SECRET must match the bot's.
# BOT_INTERNAL_URL=http://localhost:8787
INTERNAL_BOT_SECRET=local-dev-secret
# Bearer token for /api/cron/form-reminders; the route rejects every call without it.
CRON_SECRET=

# ─── Tier 3: Cloudflare R2 (file uploads) ────────────────────────────────────
# Form file uploads and resource submissions. Uploads fail with "R2 is not
# configured" without it. Ask the owner first: Cloudflare may want a payment
# method. Guide: dev-onboarding/08-optional-services/r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_FORMS_BUCKET_NAME=
R2_FORMS_PUBLIC_URL=

# ─── Tier 3: Google Drive ────────────────────────────────────────────────────
# Only /api/test-drive uses this. Your own Google Cloud service account (the
# whole key JSON on one line) + a folder shared with it.
# Guide: dev-onboarding/08-optional-services/google-drive.md
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_ROOT_FOLDER_ID=

# ─── Tier 3: QOTD admin page ─────────────────────────────────────────────────
# /admin/qotd edits the moderator order in a separate QOTD database. Without it
# the page shows an empty list. Ask the owner if you need to work on it.
QOTD_MONGODB_URI=
QOTD_DATABASE_NAME=
QOTD_COLLECTION_NAME=
QOTD_TARGET_DOCUMENT_ID=

# ─── Dev-only toggles ────────────────────────────────────────────────────────
# /tasks "view as" another member. Only works with a local database, outside
# production, for admins.
TASKS_DEV_IMPERSONATION=false
