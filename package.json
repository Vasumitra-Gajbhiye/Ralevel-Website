{
  "name": "ralevel",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=@ralevel/website",
    "dev:website": "turbo run dev --filter=@ralevel/website",
    "dev:bot": "turbo run dev --filter=@ralevel/bot",
    "build": "turbo run build",
    "build:website": "turbo run build --filter=@ralevel/website",
    "start:website": "turbo run start --filter=@ralevel/website",
    "start:bot": "turbo run start --filter=@ralevel/bot",
    "lint": "turbo run lint",
    "export-command-catalog": "pnpm --filter @ralevel/bot export-command-catalog",
    "deploy-commands": "node apps/bot/scripts/deploy-commands.js"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
