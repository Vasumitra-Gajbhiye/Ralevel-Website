{
  "name": "ralevel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "dev": "pnpm --filter @ralevel/website dev",
    "dev:website": "pnpm --filter @ralevel/website dev",
    "dev:bot": "pnpm --filter @ralevel/applications-bot dev",
    "build": "turbo run build",
    "build:website": "pnpm --filter @ralevel/website build",
    "build:bot": "pnpm --filter @ralevel/applications-bot build",
    "start:website": "pnpm --filter @ralevel/website start",
    "start:bot": "pnpm --filter @ralevel/applications-bot start",
    "lint": "turbo run lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:restore": "tsx scripts/db/restore.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:seed-fake": "pnpm --filter @ralevel/website exec tsx scripts/seedFake.ts",
    "db:export-seed": "tsx scripts/db/export-seed.ts"
  },
  "devDependencies": {
    "dotenv": "^17.3.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vasumitra-Gajbhiye/r-alevel.git"
  },
  "license": "ISC"
}
